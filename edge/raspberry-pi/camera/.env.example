# Edge Camera Capture Configuration
# Copy to .env and adjust values for your environment

# Device identity
DEVICE_ID=rpi5-001

# Camera settings
CAMERA_DEVICE=0                    # /dev/video0 index
CAPTURE_INTERVAL_SECONDS=60        # Capture interval
CAPTURE_RESOLUTION_WIDTH=1920      # Image width
CAPTURE_RESOLUTION_HEIGHT=1080     # Image height
CAPTURE_JPEG_QUALITY=80            # JPEG quality (1-100)

# Primary output: ONTAP NFS mount
ONTAP_NFS_PATH=/mnt/ontap/images
ONTAP_RESULT_PATH=/mnt/ontap/results
ONTAP_SVM_NAME=svm-iot
ONTAP_VOLUME_NAME=vol_images

# Factory hierarchy (v3 aligned event schema)
SITE_ID=lab-tokyo
LINE_ID=line-01
EVENT_DOMAIN=manufacturing
ASSET_TYPE=3d_printer
ASSET_ID=bambu-p2s-001
EQUIPMENT_ID=printer-001
SENSOR_ID=camera-001

# Kafka event publishing
KAFKA_ENABLED=false                       # Set to "true" when Kafka broker is ready
KAFKA_BOOTSTRAP_SERVERS=localhost:9092     # Instaclustr managed Kafka broker(s)
KAFKA_TOPIC=factory.events.raw
KAFKA_BUFFER_PATH=/tmp/kafka-buffer       # Local buffer when Kafka unreachable

# Lambda analysis (optional: set S3_BUCKET to enable)
LAMBDA_FUNCTION_NAME=edge-to-cloud-image-analyzer
AWS_REGION=ap-northeast-1
S3_BUCKET=

# Logging
LOG_LEVEL=INFO
