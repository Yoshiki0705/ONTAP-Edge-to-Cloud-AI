# Lab environment — variable names only. Copy to .env and fill in locally.
#
#   cp scripts/lab/.env.example scripts/lab/.env
#   chmod 600 scripts/lab/.env
#
# scripts/lab/.env is gitignored. This template is tracked, which needs the
# `!.env.example` negation in .gitignore — without it the `.env.*` rule swallows the
# template and `git add` silently does nothing.
#
# Nothing in scripts/lab/ prints a value from this file. The reachability report names
# the variable, not its contents, so a pasted report cannot leak the topology. Pass
# --show-targets to see resolved values on your own terminal; never redirect that into a
# file the repository tracks.

# ── Hypervisor ────────────────────────────────────────────────────────────────────────
ESXI_HOST=
ESXI_SSH_USER=
VCENTER_HOST=

# ── ONTAP cluster (FAS2750) ───────────────────────────────────────────────────────────
ONTAP_CLUSTER_MGMT=
ONTAP_NODE_1=
ONTAP_NODE_2=

# Admin is only used by tasks invoked with --apply. Tasks 1, 2 and 6 authenticate as the
# read-only user below, so a verification run cannot change the cluster even by mistake.
ONTAP_ADMIN_USER=
ONTAP_RO_USER=

# Path to the private key for ONTAP SSH. Prefer a key over a password: a password in an
# env var reaches the process table on some platforms.
ONTAP_SSH_KEY=

# ── svm1 (NAS, on-premises ONTAP) ─────────────────────────────────────────────────────
SVM1_NAME=
NFS_LIF_1=
NFS_LIF_2=
NFS_EXPORT_DATASTORE=
NFS_EXPORT_VOL1=

# svm1 also serves S3 once task 3 enables it there. Two SVMs cannot share a volume, so
# NFS + S3 over the same data requires the S3 server on svm1 rather than on svm2-s3.
SVM1_S3_LIF=
SVM1_S3_BUCKET=

# ── svm2-s3 (ONTAP S3, ClickHouse tiering and Instaclustr backup) ─────────────────────
SVM2_S3_NAME=
S3_LIF_1=
S3_LIF_2=
S3_TIERING_BUCKET=
S3_BACKUP_BUCKET=

# S3 credentials are written by task 3 into the secrets file, never into this one and
# never to stdout. Names are listed so a reader knows what to expect there.
# ONTAP_S3_ACCESS_KEY / ONTAP_S3_SECRET_KEY  -> scripts/lab/.secrets

# ── Instaclustr VMs ───────────────────────────────────────────────────────────────────
# Zero Inbound: the gateway holds a reverse SSH tunnel outward, so nothing dials in.
GATEWAY_HOST=
GATEWAY_SSH_USER=
GATEWAY_TUNNEL_PORT=

KAFKA_NODE_1=
KAFKA_NODE_2=
KAFKA_NODE_3=
KAFKA_BOOTSTRAP_PORT=
KAFKA_TOPIC=

CLICKHOUSE_GW=
CLICKHOUSE_NODE=
CLICKHOUSE_HTTP_PORT=
CLICKHOUSE_USER=

# ── Edge ──────────────────────────────────────────────────────────────────────────────
PI_HOST=
PI_SSH_USER=
PI_NFS_MOUNTPOINT=

# ── Lab run metadata ──────────────────────────────────────────────────────────────────
# Stamped into docs/verification-evidence/ so a result can be tied to the run that
# produced it. Without these an evidence file is a number with no environment.
LAB_RUN_ID=
LAB_ONTAP_VERSION=
LAB_REGION=
