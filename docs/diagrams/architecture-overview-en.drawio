rce="ath" target="quick"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;*1 S3 access points require ONTAP 9.17.1 or later&lt;/b&gt;&lt;br&gt;Same Region, same account, and a mounted volume&lt;br&gt;&lt;b&gt;*2 Authorization is evaluated in two layers&lt;/b&gt;&lt;br&gt;A request has to pass both IAM and file system permissions&lt;br&gt;&lt;b&gt;*4 Hardware testing incomplete&lt;/b&gt;&lt;br&gt;The edge side and ONTAP integration are unverified" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F7F7F7;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1200" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>