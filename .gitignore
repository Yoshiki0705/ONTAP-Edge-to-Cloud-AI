# IDE & Editor
.kiro/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment & Secrets
*.env
.env.*
# The template is the one file here that must be tracked. Without this negation the
# rule above swallows it and `git add .env.example` silently does nothing -- verified
# with `git check-ignore`, which reported .env.example as ignored by `.env.*`.
!.env.example
!**/.env.example
.secrets
.secrets.*
secrets/
# Raw device transcripts from scripts/lab: these carry management addresses and
# controller serial numbers verbatim. The redacted summaries under
# docs/verification-evidence/ are the tracked artefact.
scripts/lab/.evidence/
*.pem
*.key
*.tfvars
!*.tfvars.example
*-params.json
!*-params.example.json
cfn-params/*.local.json

# Private operational logs
.private/
**/.private/

# Temporary files
.tmp/
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Node
node_modules/
package-lock.json

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Test outputs
**/tests/results/
**/tests/screenshots/
**/tests/sample_images/*.jpg
**/tests/sample_images/*.png

# Build artifacts
dist/
build/
.aws-sam/

# Blog drafts (not public)
blog/

# Playwright MCP logs
.playwright-mcp/
